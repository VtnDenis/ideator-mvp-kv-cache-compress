{
  "functions": {
    "api/index.py": {
      "memory": 512,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/(.*)", "destination": "/static/$1" }
  ],
  "static": {
    "directory": "static",
    "headers": {
      "/static/**": { "Cache-Control": "public, max-age=3600" }
    }
  }
}
